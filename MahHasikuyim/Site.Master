<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MahHasikuyim.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>מה הסיכויים</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background-color: #f2f2f2;
            direction: rtl;
            text-align: center;
        }

        .header {
            background-color: #222;
            color: white;
            padding: 20px;
            font-size: 35px;
            font-weight: bold;
        }

        .container {
            margin-top: 30px;
        }

        .greenBtn {
            background-color: green;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
        }
           .blueBtn {
            background-color: royalblue;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
        }

        .yellowBtn {
            background-color: gold;
            color: black;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
        }

        .answerBox {
            width: 250px;
            padding: 10px;
            font-size: 18px;
            border-radius: 10px;
        }

        img {
            width: 400px;
            border-radius: 20px;
            margin-top: 20px;
        }

        .result {
            color: red;
            font-size: 45px;
            font-weight: bold;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

<form id="form1" runat="server">

    <div class="header">
        מה הסיכויים
    </div>

    <div class="container">
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>
    </div>

</form>
</body>
</html>
